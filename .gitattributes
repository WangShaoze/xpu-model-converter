# 交付层脚本与模板必须保持 LF 换行:
# 这些文件会在 Linux 服务器/容器内执行, CRLF 会导致
# `sh build.sh` 报 "Syntax error: word unexpected (expecting \"in\")"。
*.sh        text eol=lf
*.j2        text eol=lf
*.conf      text eol=lf
*.txt       text eol=lf
Dockerfile  text eol=lf

# 二进制文件不做换行转换
*.pt     binary
*.onnx   binary
*.xpu    binary
*.tgz    binary
*.zip    binary
*.whl    binary
