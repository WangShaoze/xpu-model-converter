# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# 代码图谱索引缓存
.codegraph/

# 转换产物 / 交付包
dist/
output/
output_seg/
t_obb/
t_pose/
build/
*.xpu

# Worker/API 运行时工作区(模型上传落盘、Job 临时产物)
worker-workspace/

# 开发数据库(Phase 3, 生产用 Postgres)
*.db
*.sqlite3

# 认证 RSA 私钥(登录密码传输加密): 仅本地开发自动生成, 严禁入库
dev-auth-key.pem

# 环境密钥文件(含数据库/MinIO/JWT 等 Secret): 仅 .env.example 模板入库
.env
.env.local
.env.*.local
# 开发环境 TLS 自签证书(scripts/dev-tls.sh 生成)
dev-certs/

# 模型权重目录: 权重一律不入库, 仅保留占位文件
models/*
!models/.gitkeep

# ultralytics 运行缓存
Ultralytics/

# 交付包依赖轮子: 体积较大不入库, 需自行准备到该目录
# (否则 Dockerfile 的 pip install 无轮子可装, 交付包会缺 gunicorn/onnxruntime 等依赖)。
# 所需集合见 configs/hardware/kunlun.yaml 中 packages_dir 的注释。
vendor/wheels/

# 接口验证测试图(本地素材)
images/yolov5-test-images/
