#!/bin/bash
# =====================================================================
# {{ package_name }} 算法组件自动部署脚本
# (由 xpu-model-converter docker_export 渲染生成, 请勿手工修改)
#
# 功能: 使用本目录 Dockerfile 构建算法镜像并启动容器
# 用法:
#   sh build.sh [install|-i|--install]   # 安装: 删除旧容器/镜像后构建并启动(默认)
#   sh build.sh [stop|-s|--stop]         # 停止并删除容器
#   sh build.sh [restart|-r|--restart]   # 重启容器
#   sh build.sh [delete|-d|--delete]     # 删除容器与镜像
#   sh build.sh [help|-h|--help]         # 用法说明
# 说明:
#   - 部署参数(端口/卡号/并发/上报地址等)在 Dockerfile 的 ENV 中, 可改后重新 install
#   - docker run 时也可追加 -e 参数覆盖, 例如: -e WEB_PORT={{ web_port }} -e workers=2
#   - 昆仑芯 XPU 服务器带 --privileged --device=/dev/xpuctrl 启动;
#     若目标机无该设备节点, 脚本会自动去掉该参数并以 CPU 模式启动
# =====================================================================

image_name="{{ image_name }}"
image_tag="{{ image_tag }}"
image_full="${image_name}:${image_tag}"
container_name="{{ container_name }}"

# 从 Dockerfile 读取默认端口
web_port=$(grep -oP "(?<=ENV WEB_PORT=).*" Dockerfile | tr -d '\n\r')

# 昆仑芯 XPU 服务器需要 --device=/dev/xpuctrl; 若该设备节点不存在,
# docker run 会直接报错退出, 因此这里按实际设备探测, 无卡机器自动降级 CPU 运行
if [ -e /dev/xpuctrl ]; then
    devices_params="--privileged --device=/dev/xpuctrl"
else
    devices_params="--privileged"
    echo "!! 未检测到 /dev/xpuctrl 设备节点, 将以 CPU 模式启动容器"
fi

help_info() {
    cat <<EOF
用法:
  sh build.sh [install|-i|--install]   # 安装(默认): 删除旧版本容器和镜像后构建并启动
  sh build.sh [stop|-s|--stop]         # 停止并删除当前容器
  sh build.sh [restart|-r|--restart]   # 重启当前容器
  sh build.sh [delete|-d|--delete]     # 删除容器与镜像
  sh build.sh [help|-h|--help]         # 用法说明
EOF
}

cmd=$1
case "$cmd" in
""|install|-i|--install) action=install ;;
stop|-s|--stop) action=stop ;;
restart|-r|--restart) action=restart ;;
delete|-d|--delete) action=delete ;;
help|-h|--help|*) action=help ;;
esac

if [ "$action" = "help" ]; then
    help_info
    exit 0
fi

echo "==> 镜像: ${image_full}  容器: ${container_name}  端口: ${web_port}"

# 删除旧容器(若存在)
if docker ps -a --format '{% raw %}{{.Names}}{% endraw %}' | grep -q "^${container_name}$"; then
    echo "==> 删除旧容器 ${container_name}"
    docker rm -f ${container_name} > /dev/null 2>&1
fi

# 删除旧镜像(若存在)
old_image_id=$(docker images --format '{% raw %}{{.Repository}}:{{.Tag}} {{.ID}}{% endraw %}' | grep "^${image_full} " | awk '{print $2}')
if [ -n "$old_image_id" ]; then
    echo "==> 删除旧镜像 ${image_full}"
    docker rmi ${image_full} > /dev/null 2>&1
fi

case "$action" in
stop)
    echo "==> 已停止并删除容器 ${container_name}"
    exit 0
    ;;
delete)
    echo "==> 已删除容器与镜像 ${image_full}"
    exit 0
    ;;
restart)
    echo "==> 容器已清理,请重新执行 sh build.sh install 构建并启动"
    exit 0
    ;;
esac

# 构建镜像
echo "==> 开始构建镜像: ${image_full}"
docker build -t ${image_full} .
if [ $? -ne 0 ]; then
    echo "!! 镜像构建失败,请检查上方错误信息"
    exit 1
fi

# 启动容器
echo "==> 启动容器: ${container_name} (端口 ${web_port})"
docker run -d \
    -p ${web_port}:${web_port} \
    --name ${container_name} \
    ${devices_params} \
    --restart=always \
    ${image_full}

if [ $? -ne 0 ]; then
    echo "!! 容器启动失败, 请检查上方 docker run 报错信息"
    exit 1
fi

echo "==> 部署完成. 健康检查: curl http://localhost:${web_port}/health"
exit 0
