# !/bin/bash
# {{ package_name }} 容器启动入口(算法目录内, 由 xpu-model-converter 渲染生成)
$SOURCE_PARAM

# 交付内容自检: 模型与类别配置缺失时直接退出, 避免静默起服务
if [ ! -f "{{ model_file }}" ]; then
    echo "!! 未找到模型文件 {{ model_file }}, 请检查交付包完整性"
    exit 1
fi
if [ ! -f "confidence.json" ]; then
    echo "!! 未找到类别配置 confidence.json, 请检查交付包完整性"
    exit 1
fi
{% if degraded %}
echo "!! 警告: 本次导出未接入昆仑 SDK, {{ model_file }} 为占位产物(内容为规范化 ONNX), 仅供联调, 请勿交付客户"
{% endif %}

# 启动容器内日志转发服务(未配置 MINIO/KAFKA 时自动空转, 不影响识别服务)
nohup python send_log_webserver.py > /dev/null 2>&1 &

# NWAI_FLASK_ONLY 存在时用 Flask 开发服务器调试, 否则用 gunicorn 生产模式
if [ -n "${NWAI_FLASK_ONLY+x}" ]; then
    exec python nwai_webserver.py
else
    exec python nwai_gunicorn.py
fi
