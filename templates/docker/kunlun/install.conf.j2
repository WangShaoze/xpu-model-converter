# 部署参数
# (由 xpu-model-converter docker_export 渲染生成, 与 manifest.json 保持一致)
# 客户现场部署时按需修改, 并同步修改 Dockerfile 中对应 ENV(或使用 docker run -e 覆盖)
MODEL_NAME={{ model_name }}
MODEL_VERSION={{ model_version }}
GPU_ID={{ gpu_id }}
WORKERS={{ workers }}
DEVICE={{ device }}
WEB_PORT={{ web_port }}
HOST_IP={{ host_ip }}
CONF_THRES={{ conf_thres }}
IOU_THRES={{ iou_thres }}

# MINIO/KAFKA 日志上报(不填或为空则自动关闭上报)
MINIO_HOST={{ minio_host }}
MINIO_PORT={{ minio_port }}
MINIO_BUCKET={{ minio_bucket }}
MINIO_ACCESS_KEY={{ minio_access_key }}
MINIO_SECRET_KEY={{ minio_secret_key }}
KAFKA_HOST={{ kafka_host }}
KAFKA_PORT={{ kafka_port }}
KAFKA_TOPIC={{ kafka_topic }}
PROVINCE_CODE=
BUREAU_CODE=
REGION_CODE=
