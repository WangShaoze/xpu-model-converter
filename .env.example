# =============================================================================
# XPU Model Converter - Docker Compose 环境变量模板(Phase 7 §41)
#
# 用法: cp .env.example .env, 然后按需修改。
#   - docker compose up 会自动读取同目录 .env; 不复制也可用 compose 文件内的默认值。
#   - .env 含 Secret, 已被 .gitignore 忽略, 严禁提交真实密钥。
#   - 生产部署务必替换全部 CHANGE_ME / dev 默认值, 并使用强随机 JWT_SECRET(≥32 字节)。
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL(容器内初始化 + API/Worker 连接)
# -----------------------------------------------------------------------------
POSTGRES_USER=xpu
POSTGRES_PASSWORD=xpu_dev_password
POSTGRES_DB=xpu
# 容器内通过服务名 xpu-model-converter-postgres 互连; 驱动固定 psycopg2
DATABASE_URL=postgresql+psycopg2://xpu:xpu_dev_password@xpu-model-converter-postgres:5432/xpu

# -----------------------------------------------------------------------------
# Redis(任务队列后端)
# QUEUE_BACKEND: redis(Docker Compose/生产) | memory(单进程本地开发/测试)
# -----------------------------------------------------------------------------
QUEUE_BACKEND=redis
REDIS_URL=redis://xpu-model-converter-redis:6379/0

# -----------------------------------------------------------------------------
# MinIO(Artifact 对象存储)
# STORAGE_BACKEND: minio(Docker Compose/生产) | local(本地磁盘, 不用 MinIO)
# MINIO_ROOT_USER/PASSWORD 是 MinIO 服务端 root 凭据;
# MINIO_ACCESS_KEY/SECRET_KEY 是 API/Worker 的客户端凭据(开发态复用 root)。
# -----------------------------------------------------------------------------
STORAGE_BACKEND=minio
MINIO_ROOT_USER=xpu_minio
MINIO_ROOT_PASSWORD=xpu_minio_dev_password
MINIO_ENDPOINT=xpu-model-converter-minio:9000
MINIO_ACCESS_KEY=xpu_minio
MINIO_SECRET_KEY=xpu_minio_dev_password
MINIO_BUCKET=xpu-models
# 容器内走 HTTP; 生产经 TLS 网关时置为 true
MINIO_SECURE=false

# -----------------------------------------------------------------------------
# API 安全 / 运行时
# -----------------------------------------------------------------------------
# JWT 签名密钥: 生产必须覆盖, 建议 `openssl rand -hex 32`
JWT_SECRET=dev-only-secret-change-me-please-0123456789abcdef
# RSA-OAEP 私钥路径(登录密码传输加密): 容器内位于共享卷 /workspace;
# 文件缺失时开发模式自动生成, 生产必须注入持久化密钥(权限 0600)。
AUTH_RSA_KEY_PATH=/workspace/dev-auth-key.pem
LOG_LEVEL=INFO

# API/Worker 共享工作区(上传模型、Job 临时产物); compose 内为具名卷挂载点
WORKSPACE_ROOT=/workspace

# 上传策略(§46)
MAX_UPLOAD_MB=200
ALLOWED_EXTENSIONS=.pt,.pth,.onnx

# 登录防暴力破解(可选, 缺省即下列值)
LOGIN_RATE_PER_MINUTE=10
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
REGISTER_RATE_PER_HOUR=10

# -----------------------------------------------------------------------------
# Worker
# compose 默认起 CPU-STUB worker; 真实 XPU Worker 须在装有昆仑 SDK/驱动的
# 宿主机上独立部署, 见 deploy/docker-compose.xpu.yml
# -----------------------------------------------------------------------------
XPU_WORKER_ID=xpu-model-converter-worker-cpu-01
XPU_CHIP=CPU-STUB
XPU_DEVICE_ID=0
# 真实 XPU 部署时填写(基准/审计强制字段), CPU stub 可留空
XPU_SDK_VERSION=
XPU_DRIVER_VERSION=

# -----------------------------------------------------------------------------
# 前端(Next.js 构建期注入, 浏览器视角的 API 地址)
# 浏览器在宿主机访问, 因此指向 localhost 而非容器服务名
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
